+#if ELKS && !MW_FEATURE_AREAS
+/* Caller must first negotiate GR_MODE_HAVE_READPIXEL via GrGetGCInfo. */
+void GrReadArea(GR_DRAW_ID id, GR_COORD x, GR_COORD y, GR_SIZE width,
+               GR_SIZE height, GR_PIXELVAL *pixels)
+{
+    nxReadAreaReq *req;
+    *pixels = 255;
+    if (width != 1 || height != 1) return;
+    LOCK(&nxGlobalLock);
+    req = AllocReq(ReadArea);
+    req->drawid=id; req->x=x; req->y=y; req->width=1; req->height=1;
+    TypedReadBlock(pixels, sizeof(*pixels), GrNumReadArea);
+    UNLOCK(&nxGlobalLock);
+}
+#endif
