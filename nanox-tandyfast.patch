+/* Text: a 1-bit glyph (16-bit words, most significant bit first, src_pitch bytes per row) to the
+ * screen or a memory surface, 1 bits in the foreground colour, 0 bits left alone or in the
+ * background colour with usebg. The engine clips the destination before calling (srcx may start
+ * inside a word). Two pixels go out per byte; before, every glyph pixel went through DrawPixel,
+ * and the per-glyph fallback also re-showed the software cursor between glyphs. */
+static void maskblit(PSD p, PMWBLITPARMS gc)
+{
+    MWCOORD y, w = gc->width, h = gc->height;
+    unsigned char fg = gc->fg_pixelval & 15, bg = gc->bg_pixelval & 15, pair = fg * 17;
+    const MWIMAGEBITS *row = (const MWIMAGEBITS *)((const unsigned char *)gc->data + gc->src_pitch * (unsigned)gc->srcy) + (gc->srcx >> 4);
+    unsigned skip = gc->srcx & 15;
+    for (y = 0; y < h; y++, row = (const MWIMAGEBITS *)((const unsigned char *)row + gc->src_pitch)) {
+        const MWIMAGEBITS *s = row;
+        FARADDR a = pixeladdr(p, gc->dstx, gc->dsty + y);
+        unsigned bits = ((unsigned)*s++ << skip) & 0xFFFFu;
+        int left = 16 - (int)skip, n = w;
+        if (gc->dstx & 1) {                             /* a lone first pixel in a low nibble */
+            if (bits & 0x8000) *a = (*a & 0xF0) | fg;
+            else if (gc->usebg) *a = (*a & 0xF0) | bg;
+            a++; n--;
+            bits = (bits << 1) & 0xFFFFu;
+            if (--left == 0) { bits = *s++; left = 16; }
+        }
+        while (n >= 2) {                                /* whole bytes: two pixels at a time */
+            unsigned b0, b1;
+            b0 = bits & 0x8000; bits = (bits << 1) & 0xFFFFu;
+            if (--left == 0) { bits = *s++; left = 16; }
+            b1 = bits & 0x8000; bits = (bits << 1) & 0xFFFFu;
+            if (--left == 0) { bits = *s++; left = 16; }
+            if (gc->usebg) *a = (unsigned char)(((b0 ? fg : bg) << 4) | (b1 ? fg : bg));
+            else if (b0 && b1) *a = pair;
+            else if (b0) *a = (*a & 0x0F) | (fg << 4);
+            else if (b1) *a = (*a & 0xF0) | fg;
+            a++; n -= 2;
+        }
+        if (n) {                                        /* a last pixel in a high nibble */
+            if (bits & 0x8000) *a = (*a & 0x0F) | (fg << 4);
+            else if (gc->usebg) *a = (*a & 0x0F) | (bg << 4);
+        }
+    }
+}
 static SUBDRIVER packed4 = {
-    drawpixel, readpixel, hline, vline, gen_fillrect, blit
+    drawpixel, readpixel, hline, vline, gen_fillrect, blit,
+    0, 0, 0, 0, maskblit               /* BlitCopyMaskMonoWordMSB: core font glyphs */
 };
 PSUBDRIVER tandyplan4[4] = { &packed4 };
 PSUBDRIVER memplan4[4] = { &packed4 };
