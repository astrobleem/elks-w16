 extern unsigned int tandy_screen_segment;
 
+/* byte offset of each screen row in the interleaved mode 09h layout: bank (y & 3) at 8 KB steps,
+ * 160 bytes per row within a bank. A lookup replaces a multiply and two shifts per pixel. */
+static unsigned int rowoff[200];
+static int rowoff_ready;
