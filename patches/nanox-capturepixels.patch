+/* Whole source is validated before the first status/pixel byte is returned. */
+static void GrCapturePixelsWrapper(void *r)
+{
+    nxCapturePixelsReq *req=r;
+    unsigned short bytes=0;
+#if ELKS && !MW_FEATURE_AREAS
+    GR_WINDOW *wp;
+    GR_GC *gc;
+    PSD psd;
+    unsigned char row[320];
+    unsigned pitch;
+    int x,y,i,j;
+    long sx,sy;
+    if (req->hilength || GetReqLen(req)!=sizeof(*req)) goto refuse;
+    if (req->width<=0 || req->width>640 || req->height<=0 || req->height>480 ||
+        req->x<0 || req->y<0) goto refuse;
+    pitch=(req->width+1)/2;
+    if ((unsigned)req->height>16384u/pitch) goto refuse;
+    wp=GsFindWindow(req->drawid);gc=GsFindGC(req->gcid);
+    if (!wp || !gc || gc->owner!=curclient || gc->regionid || !wp->realized || !wp->output ||
+        (wp!=rootwp && wp->owner!=curclient) || wp->psd->ncolors!=16 ||
+        req->x>wp->width || req->width>wp->width-req->x ||
+        req->y>wp->height || req->height>wp->height-req->y) goto refuse;
+    sx=(long)wp->x+req->x;sy=(long)wp->y+req->y;
+    if (sx<0 || sy<0 || sx+req->width>wp->psd->xvirtres ||
+        sy+req->height>wp->psd->yvirtres) goto refuse;
+    x=(int)sx;y=(int)sy;
+    for(j=0;j<req->height;j++) for(i=0;i<req->width;i++)
+        if(GsFindVisibleWindow(x+i,y+j)!=wp) goto refuse;
+    bytes=pitch*req->height;
+    psd=wp->psd; /* client disconnect can destroy wp during a write */
+    GdCheckCursor(psd,x,y,x+req->width-1,y+req->height-1);
+    if (GsWriteType(current_fd,GrNumCapturePixels)<0 ||
+        GsWrite(current_fd,&bytes,sizeof(bytes))<0) goto finish;
+    for(j=0;j<req->height;j++) {
+        memset(row,0,pitch);
+        for(i=0;i<req->width;i++)
+            row[i/2] |= psd->ReadPixel(psd,x+i,y+j) << ((i&1)?0:4);
+        if (GsWrite(current_fd,row,pitch)<0) goto finish;
+    }
+finish:
+    GdFixCursor(psd);
+    return;
+refuse:
+#endif
+    if (GsWriteType(current_fd,GrNumCapturePixels)>=0)
+        GsWrite(current_fd,&bytes,sizeof(bytes));
 }
 
