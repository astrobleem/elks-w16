+#if ELKS && AUTO_START_SERVER
+#include <fcntl.h>
+/* Only the cold-starting process owns this wait. The server keeps the write
+ * end across exec; EOF follows its console cleanup and process exit. */
+static int nxAutoPipe = -1;
+static int nxAutoOwner;
+static void nxHandoffTimeout(int sig)
+{
+    (void)sig;
+    EPRINTF("Nano-X: owned server handoff timed out\n");
+    _exit(127);
+}
+static void nxWaitAutoServer(int wait)
+{
+    int fd = nxAutoPipe;
+    nxAutoPipe = -1;
+    if (fd < 0) return;
+    if (wait && nxAutoOwner == getpid()) {
+        char byte;
+        int result;
+        void (*old)(int) = signal(SIGALRM, nxHandoffTimeout);
+        if (old != SIG_ERR) {
+            /* ELKS pipes have no select hook. This channel is never written;
+             * a blocking read returns EOF only when the server has exited.
+             * GrClose's existing flush guard has already cancelled its alarm. */
+            alarm(30);
+            result = read(fd, &byte, 1);
+            alarm(0); signal(SIGALRM, old);
+            if (result != 0)
+                EPRINTF("Nano-X: owned server handoff interrupted or failed\n");
+        } else EPRINTF("Nano-X: cannot guard owned server handoff\n");
+    }
+    close(fd);
+}
+#endif
