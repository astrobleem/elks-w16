+#if ELKS && !MW_FEATURE_AREAS
+/* Negotiated one-pixel readback only; 255 is invalid for the 16-color backend. */
+void GrReadArea(GR_DRAW_ID id, GR_COORD x, GR_COORD y, GR_SIZE width,
+               GR_SIZE height, GR_PIXELVAL *pixels)
+{
+    GR_WINDOW *wp;
+    long sx, sy;
+    *pixels = 255;
+    if (width != 1 || height != 1 || x < 0 || y < 0) return;
+    wp = GsFindWindow(id);
+    if (!wp || !wp->realized || !wp->output ||
+        (wp != rootwp && wp->owner != curclient) ||
+        x >= wp->width || y >= wp->height || wp->psd->ncolors != 16) return;
+    sx = (long)wp->x + x; sy = (long)wp->y + y;
+    if (sx < 0 || sy < 0 || sx >= wp->psd->xvirtres || sy >= wp->psd->yvirtres) return;
+    if (wp != rootwp && GsFindVisibleWindow((GR_COORD)sx,(GR_COORD)sy) != wp) return;
+    GdReadArea(wp->psd, (GR_COORD)sx, (GR_COORD)sy, 1, 1, pixels);
+}
+#endif
