 #include <linuxmt/sched.h>
 #include "console.h"
 #include "conio.h"
+#include <linuxmt/memory.h>
 
 char kbd_name[] = "polling";
 
 static void restart_timer(void);
 
+/*
+ * INT 16h gives 3920h for Space and Alt+Space alike, so Alt+Space is told from Space by the BIOS
+ * shift flags. Read when the key is read, they can be wrong: the key may wait in the BIOS buffer
+ * until after Alt is released, or Alt may go down for the next key before it is read. While a
+ * graphics program holds the console the driver runs every tick and notes the Alt state of each key
+ * when it first sees it in the buffer (BDA 41Eh-43Dh, head 41Ah, tail 41Ch); keys it did not see
+ * arrive, or a BIOS with its buffer elsewhere, fall back to the flags at read time.
+ */
+#define KB_HEAD	0x1A
+#define KB_TAIL	0x1C
+#define KB_BUF	0x1E
+#define KB_END	0x3E
+static unsigned char key_alt[16], key_seen[16];
+static unsigned int last_tail;
+
+static int kb_slot(unsigned int off)
+{
+    return off >= KB_BUF && off < KB_END && !(off & 1) ? (off - KB_BUF) >> 1 : -1;
+}
+
+static void alt_sample(void)
+{
+    unsigned int tail = peekw(KB_TAIL, 0x40), t = last_tail;
+    unsigned char alt = peekb(0x17, 0x40) & 0x08;
+    int n = 16;
+
+    if (kb_slot(tail) >= 0 && kb_slot(t) >= 0) {
+	while (t != tail && n--) {
+	    key_alt[kb_slot(t)] = alt;
+	    key_seen[kb_slot(t)] = 1;
+	    if ((t += 2) >= KB_END)
+		t = KB_BUF;
+	}
+    }
+    last_tail = tail;
+}
+
