+#if ELKS && !MW_FEATURE_AREAS
+int GrCapturePixels(GR_DRAW_ID id, GR_GC_ID gc, GR_COORD x, GR_COORD y,
+                    GR_SIZE width, GR_SIZE height, GR_CAPTURE_CALLBACK row, void *ctx)
+{
+    nxCapturePixelsReq *req;
+    GR_GC_INFO gi;
+    unsigned char packed[320];
+    unsigned short bytes, expected, pitch;
+    unsigned int i;
+    int ok = 0;
+    if (!row || x < 0 || y < 0 || width <= 0 || width > 640 ||
+        height <= 0 || height > 480) return 0;
+    pitch = (width+1)/2;
+    if ((unsigned)height > 16384u/pitch) return 0;
+    expected = pitch*height;
+    memset(&gi,0,sizeof(gi));GrGetGCInfo(gc,&gi);
+    if (gi.gcid != gc || gi.region || !(gi.mode & GR_MODE_HAVE_CAPTUREPIXELS)) return 0;
+    LOCK(&nxGlobalLock);
+    req=AllocReq(CapturePixels);
+    req->drawid=id;req->gcid=gc;req->x=x;req->y=y;req->width=width;req->height=height;
+    if (TypedReadBlock(&bytes,sizeof(bytes),GrNumCapturePixels) == -1) goto done;
+    if (!bytes) goto done;
+    if (bytes != expected) {
+        /* Drain an invalid response without invoking the destination callback. */
+        while (bytes) { unsigned n=bytes>sizeof(packed)?sizeof(packed):bytes;
+            if (ReadBlock(packed,n)==-1) goto done; bytes-=n; }
+        goto done;
+    }
+    for(i=0;i<(unsigned)height;i++) {
+        if (ReadBlock(packed,pitch)==-1) goto done;
+        row(ctx,i,packed,pitch);
+    }
+    ok=1;
+done:
+    UNLOCK(&nxGlobalLock);
+    return ok;
+}
+#endif
