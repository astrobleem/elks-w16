+static void rowoff_init(void)
+{
+    int y;
+    for (y = 0; y < 200; y++)
+        rowoff[y] = ((unsigned)(y & 3) << 13) + (unsigned)(y >> 2) * 160;
+    rowoff_ready = 1;
+}
